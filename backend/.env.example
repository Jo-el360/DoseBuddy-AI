# DoseBuddy AI Backend Environment Configuration

# Server Settings
PROJECT_NAME="DoseBuddy AI"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Security & CORS
SECRET_KEY="dosebuddy-secret-key-change-in-production"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","*"]

# Gemini API Key (Set your Google AI Studio API key)
GEMINI_API_KEY="your-gemini-api-key-here"

# Firebase Credentials Path (Optional if using Mock Mode for local testing)
FIREBASE_CREDENTIALS_PATH="firebase-service-account.json"
USE_MOCK_SERVICES=true

# Caregiver Escalation Configuration
MISSED_DOSE_THRESHOLD_MINUTES=30
